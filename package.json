{
  "name": "smart-labels",
  "version": "0.0.15",
  "description": "Fast automatic label placement for D3 scatterplots using Voronoi cells and occlusion detection",
  "keywords": [
    "d3",
    "labels",
    "label-placement",
    "voronoi",
    "delaunay",
    "occlusion",
    "scatterplot",
    "annotation",
    "visualization",
    "dataviz"
  ],
  "type": "module",
  "main": "dist/smartLabels.cjs",
  "module": "dist/smartLabels.es.js",
  "browser": "dist/smartLabels.min.js",
  "unpkg": "dist/smartLabels.min.js",
  "jsdelivr": "dist/smartLabels.min.js",
  "exports": {
    ".": {
      "import": "./dist/smartLabels.es.js",
      "require": "./dist/smartLabels.cjs",
      "default": "./dist/smartLabels.min.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "pretest": "npm run build",
    "test": "node --test",
    "lint": "eslint src test"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@rollup/plugin-terser": "^1.0.2",
    "d3": "^7.9.2",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^15.12.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "rollup": "^4.68.2"
  },
  "peerDependencies": {
    "d3": "^7.9.0"
  },
  "author": {
    "name": "John Alexis Guerra Gómez",
    "url": "https://johnguerra.co"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/john-guerra/smart-labels.git"
  },
  "bugs": {
    "url": "https://github.com/john-guerra/smart-labels/issues"
  },
  "homepage": "https://github.com/john-guerra/smart-labels"
}
