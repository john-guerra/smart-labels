{
  "name": "smart-labels",
  "version": "0.0.14",
  "description": "A basic library for adding labels to a visualization when there is enough space",
  "type": "module",
  "main": "dist/smartLabels.cjs",
  "module": "dist/smartLabels.es.js",
  "browser": "dist/smartLabels.min.js",
  "unpkg": "dist/smartLabels.min.js",
  "jsdelivr": "dist/smartLabels.min.js",
  "exports": {
    ".": {
      "import": "./dist/smartLabels.es.js",
      "require": "./dist/smartLabels.cjs",
      "default": "./dist/smartLabels.min.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "d3": "^7.9.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-html": "^8.1.2",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "rollup": "^4.20.0",
    "rollup-plugin-commonjs": "^10.1.0"
  },
  "peerDependencies": {
    "d3": "^7.9.0"
  },
  "author": {
    "name": "John Alexis Guerra Gómez",
    "url": "https://johnguerra.co"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/john-guerra/smart-labels.git"
  },
  "bugs": {
    "url": "https://github.com/john-guerra/smart-labels/issues"
  },
  "homepage": "https://github.com/john-guerra/smart-labels"
}
